# FedEx Track API 凭证示例 —— 复制为根目录 .env 使用
FEDEX_API_KEY=<your-key>
FEDEX_SECRET_KEY=<your-secret>
FEDEX_ACCOUNT_NUMBER=879197228
FEDEX_ENV=production
# 可选：不要在 .env 写死生产 URL（否则 --env sandbox 仍可能被误解）。覆盖 host 用 CLI --base-url
# FEDEX_BASE_URL=https://apis.fedex.com
# FEDEX_SANDBOX_BASE_URL=https://apis-sandbox.fedex.com
FEDEX_HTTP_PROXY=
