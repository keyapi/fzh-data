# fedex_track 运行产物（大，不入库）
fedex_track_output/
parcel_track_output/
# 定时任务等待处理/已处理完的通途导出（含买家信息，不入库）
parcel_track_input/
# 定时任务注册脚本按机器生成的包装（与 web_automation 的同类产物一致，不入库）
parcel_track/scripts/run_parcel_track_scheduled-*.cmd

# 游离的客户名单 JSON（脚本未展开 %TEMP% 环境变量，落到了仓库根）—— 含真实客户/部门名，禁入库
%TEMP%customers.json

# pb_orders 运行产物与本地缓存（数据在仓库外，这里只兜底）
pb_orders/out/
pb_orders/*.pdf
pb_orders/data/

# pb_orders Web 服务的运行状态：任务库、上传、临时件、产物，全是业务数据
pb_orders/runtime/
# 部署时按机器覆盖的 Compose 变量（可能含服务器地址）
pb_orders/.env

# erpnext_bi 本地工具与临时数据（不入仓）
erpnext_bi/bin/
erpnext_bi/tmp/
# erpnext_bi 抓取的真实业务快照（含真实客户/订单/商品，禁入库）
erpnext_bi/.orders.json
erpnext_bi/.test_so.json
erpnext_bi/dashboard_snapshot.html

# ===== 敏感信息硬拦截（2026-10-20 收敛，任何情况下不得入库）=====
# 密钥/证书类文件
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials.*
secrets.*
config.local.*
# 文件名含敏感关键词一律拦截（含 password/token/secret/api_key 的变体）
*password*
*passwd*
*token*
*secret*
*api_key*
*apikey*
# 已知明文凭证载体：AI 会话记忆（历史曾写入 ERP 生产 api_key/secret）
.workbuddy/
.codex_tmp/
# 会话 Cookie / 浏览器配置
*.cookie.txt
*.cookies.json
**/cookies.json

