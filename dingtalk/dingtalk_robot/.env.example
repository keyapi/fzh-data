# ── 钉钉机器人 ─────────────────────────────────────────
# 在钉钉群的「智能群助手 → 自定义机器人」获取
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=SECxxx

# ── ERPNext API 凭证 ──────────────────────────────────
# 在 ERPNext → My Settings → API Access → Generate Keys 获取
ERP_API_KEY=your_api_key_here
ERP_API_SECRET=your_api_secret_here

# ── ERPNext 服务器地址 (可选) ──────────────────────────
# ERP_URL=https://erpnext.vilavi.cn     # 生产环境（默认）
# ERP_URL=https://ensh.vilavi.cn        # 测试环境
