# 钉钉企业内部应用（new-api 那套也可，Client ID=原 AppKey）
# 不要把真实 Secret 提交 git。可复制为同目录 .env，或设环境变量 DINGTALK_OA_ENV 指向仓库外 env。
# DINGTALK_OA_DATA= 附件缓存目录（默认模块 data/，已 gitignore）
# DINGTALK_OA_WORK= 核算导出 Excel 所在目录（仓库外，不要把含人名的路径写进 git）
# LOCAL_NAS_PERIOD_ROOT= 本地同步盘账期资料根（只读对照；禁止往这里写。不设则相关脚本直接报错）
# DINGTALK_OA_TOOLS= 仓库外工具目录（默认模块目录）。export_period_excels.py / fill_aug_from_oa.py /
#   july_amz_by_account.py 都 import patch_july_2026，克隆仓库里没有这个文件，要自己准备。
# NAS_FINANCE_PERIOD_ROOT= NAS FileStation 账期资料根路径（可分号分隔多个候选）
DINGTALK_CLIENT_ID=dingxxxxxxxx
DINGTALK_CLIENT_SECRET=replace_me
DINGTALK_AGENT_ID=
# 销售收款确认单模板（Excel 账期明细超链接里的 processCode）
DINGTALK_OA_PROCESS_CODE=PROC-FB234439-0642-451E-A514-20FBEF4A4241
