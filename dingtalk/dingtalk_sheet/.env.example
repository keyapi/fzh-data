# 钉钉表格读取（dingtalk_sheet）
# 复制为同目录 .env，或写进仓库根 .env（worktree 里没有 .env，指向主仓库）

# ── 企业内部应用（Client ID = 原 AppKey）────────────────
DINGTALK_CLIENT_ID=dingxxxxxxxx
DINGTALK_CLIENT_SECRET=replace_me

# ── operatorId：各文档自己的 unionId（必填，且需对该文档有权限）──
# 不是 appKey / AgentId / userId；不同文档可能要不同人的 unionId
DINGTALK_OPERATOR_ID=
# 供应链两张表实测各用一个变量：
# DINGTALK_OPERATOR_ORDER=    # 2026年下单表
# DINGTALK_OPERATOR_SHIP=     # 发货信息总表

# ── 可选：指定 .env 位置（默认模块 .env → 仓库根 .env）──
# DINGTALK_SHEET_ENV=
