# Portal public URL (browser)
PORTAL_PUBLIC_URL=http://127.0.0.1:8088
PORTAL_PORT=8088
OPS_STUB_PORT=8090

# Optional: mount real board runner output (default ../board/out).
# Fresh clone without board/out: BOARD_OUT_HOST=./fixtures/board_out
# BOARD_OUT_HOST=../board/out

# DingTalk OIDC (optional — do not commit real secrets)
# Enable: DINGTALK_ENABLED=1 and `docker compose --profile dingtalk up -d`
DINGTALK_ENABLED=0
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
ALLOWED_CORP_ID=
OIDC_ISSUER=http://127.0.0.1:8088/oidc
