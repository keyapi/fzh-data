# Copy to .env and fill secrets. Never commit .env.

# Open WebUI → model gateway
OPENAI_API_BASE_URL=https://api.vilavi.cn/v1
OPENAI_API_KEY=sk-replace-me

# Open Terminal (Docker sandbox only — do not use bare metal for this PoC)
OPEN_TERMINAL_API_KEY=replace-with-long-random-string

# Host port for Open WebUI
OWUI_PORT=3000

# Optional: also used by host CLI scripts / Tool Valves fallback
# Prefer setting Tool Valves in Open WebUI UI for App ID/Secret.
SELLFOX_APP_ID=
SELLFOX_APP_SECRET=
SELLFOX_API_DOMAIN=https://openapi.sellfox.com
