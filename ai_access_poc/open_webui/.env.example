# Copy to .env and fill secrets. Never commit .env.

# Open WebUI → model gateway (api.vilavi.cn personal Token — NOT OpenAI official)
# Get at https://api.vilavi.cn/ (DingTalk login → copy Token)
OPENAI_API_BASE_URL=https://api.vilavi.cn/v1
OPENAI_API_KEY=sk-replace-me

# Open Terminal (Docker sandbox only — do not use bare metal for this PoC)
OPEN_TERMINAL_API_KEY=replace-with-long-random-string

# Host port for Open WebUI
OWUI_PORT=3000

# First-boot: avoid stalled HuggingFace SentenceTransformers download (CN)
HF_ENDPOINT=https://hf-mirror.com
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small

# --- Sellfox (prefer proxy; keep direct as fallback) ---
# Preferred: https://api.vilavi.cn/sellfox/admin DingTalk → copy sk-...
SELLFOX_PROXY_API_KEY=
SELLFOX_PROXY_BASE_URL=https://api.vilavi.cn/sellfox
SELLFOX_PROXY_ACCOUNT=sellfox-main
# Fallback direct OpenAPI (VPS whitelist IP only)
SELLFOX_APP_ID=
SELLFOX_APP_SECRET=
SELLFOX_API_DOMAIN=https://openapi.sellfox.com
