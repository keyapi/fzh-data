# 蜴国际 / yiglobal-api — 环境变量模板（无真实值）
#
# 复制到**仓库根** `.env`（gitignore）。对方目前仅有生产环境。
# HTTP 请求体字段名仍是 app_token / app_key（API 契约，勿改）。

YIGLOBAL_APP_TOKEN=your-yiglobal-app-token
YIGLOBAL_APP_KEY=your-yiglobal-app-key
YIGLOBAL_API_BASE_URL=http://47.106.72.196

# 旧名（已弃用，脚本仍兼容一版）：LIZARD_APP_TOKEN / LIZARD_APP_KEY / LIZARD_TOKEN / LIZARD_KEY
