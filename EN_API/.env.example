# ── ERPNext API 凭证 ──────────────────────────────────
# 复制此文件为 .env 并填入真实值 (不要提交 .env 到 git)
#
# 推荐: 生产/测试 分开设置 (新脚本使用此方式)
PROD_ERP_API_KEY=your_prod_api_key_here
PROD_ERP_API_SECRET=your_prod_api_secret_here
TEST_ERP_API_KEY=your_test_api_key_here
TEST_ERP_API_SECRET=your_test_api_secret_here

# 兼容: 旧脚本使用的通用凭证 (如果生产和测试相同, 可只设这两行)
ERP_API_KEY=your_api_key_here
ERP_API_SECRET=your_api_secret_here

# ── 系统 URL (可选, 覆盖默认值) ────────────────────────
# ERP_URL=https://erpnext.vilavi.cn       # 生产系统
# ERP_URL=https://ensh.vilavi.cn          # 测试系统

# ── 腾讯云机器翻译 TMT (translate_item_group_names.py) ─
# 建议专用 CAM 用户（如 tmt-api-translation）+ QcloudTMTFullAccess，勿用个人子账号主密钥
# 控制台: https://console.cloud.tencent.com/cam/capi
# 开通机器翻译: https://console.cloud.tencent.com/tmt
# TENCENT_SECRET_ID=AKIDxxxxxxxx
# TENCENT_SECRET_KEY=xxxxxxxx
# TENCENT_TMT_REGION=ap-guangzhou
