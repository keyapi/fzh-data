# PB 订单处理服务 —— 部署配置示例。
# 复制成 pb_orders/.env 后按需修改；.env 不进 Git。

# Web 监听地址与端口
#   本机验收：      PB_ORDERS_BIND=127.0.0.1
#   服务器走 NGINX：PB_ORDERS_BIND=127.0.0.1（只有反代能连，公网必须走带登录的 /pb/）
PB_ORDERS_BIND=127.0.0.1
PB_ORDERS_PORT=8412

# 挂载路径前缀。留空 = 挂在根路径（本机开发）；
# 挂在 https://api.vilavi.cn/pb/ 下时填 /pb（NGINX 会把前缀剥掉再转给应用）
PB_ORDERS_URL_PREFIX=

# 单个上传文件上限（MB）。真实 Packslip PDF 约 11MB，64 留足余量
PB_ORDERS_MAX_UPLOAD_MB=64

# 单个任务超时（秒）；PDF 合并 + 背贴生成实测几十秒
PB_ORDERS_JOB_TIMEOUT=1800

# 任务与产物保留天数
PB_ORDERS_RETENTION_DAYS=90

# worker 活着时每隔几秒对一次 Redis 队列；0 = 关掉。Redis 重启时 worker 会重连而不是退出。
PB_ORDERS_QUEUE_WATCH_SECONDS=60

# 写进任务报告、便于追溯代码版本；留空则读容器内 git（镜像里没有则记 unknown）
PB_ORDERS_PIPELINE_VERSION=

# 新建任务页预填的无货 SKU（逗号分隔）——**只是初始值**。
# 日常维护请用网页上的「断货 SKU」页（改完立即生效，无需重启）；页面里改过之后
# 这里就不再起作用。留空则表单为空。
PB_ORDERS_DEFAULT_NO_STOCK=

# ── 钉钉登录（复用公司 OIDC 桥，见 docs/reference/server-deployment-architecture.md）──
# PB_ORDERS_OIDC_ISSUER 留空 = 关闭登录；此时务必只监听回环/内网，不要暴露公网。
PB_ORDERS_OIDC_ISSUER=
PB_ORDERS_OIDC_CLIENT_ID=pb-orders
PB_ORDERS_OIDC_CLIENT_SECRET=
PB_ORDERS_OIDC_REDIRECT_URI=
# 会话签名密钥：随机 32 字节以上。用 `python -c "import secrets;print(secrets.token_urlsafe(32))"` 生成
PB_ORDERS_SESSION_SECRET=
# 允许登录的钉钉用户（显示名或 sub，逗号分隔）。
# 留空 = 任何钉钉用户都能登录（会打 WARNING）；公网暴露时建议填写。
PB_ORDERS_ALLOWED_USERS=

# 普通任务永远只读本地缓存，这里不配置任何 Google 凭证
