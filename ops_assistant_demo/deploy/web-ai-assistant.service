[Unit]
Description=Web AI assistant demo
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/web-ai-assistant
EnvironmentFile=/opt/web-ai-assistant/.env
ExecStart=/usr/bin/python3 server.py
Restart=on-failure
User=desk
Group=desk
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/web-ai-assistant/data

[Install]
WantedBy=multi-user.target
