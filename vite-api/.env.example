# Vite API — 环境变量模板（无真实值）
#
# 用法：复制键到**仓库根** `.env`（已 gitignore），填入真实值。不要提交 `.env`。
#
# 业界惯例（12-Factor）：变量名在 test/prod 保持一致，只换值。
# 不要用 VITE_API_KEY_TEST / VITE_API_KEY_PROD 作为主部署命名。
# 同机偶尔要同时持有生产 Key 时，可用 gitignore 的 `.env.vite.prod.local`，
# 或仅在专用脚本里用 VITE_PROD_API_KEY（例外，非常规路径）。

# --- 默认开发 = 测试环境 ---
VITE_API_KEY=your_api_key_here
VITE_API_BASE_URL=https://test-api.vitedirect.com

# EEVEE Web UI（非 API Key；勿写入 Markdown 明文）
VITE_EEVEE_URL=https://easygo-dev.vitedirect.com/labelHistory
VITE_TEST_ACCOUNT=your_test_account@example.com
VITE_TEST_PASSWORD=your_password_here

# Webhook URL（可选；本地常留空，改轮询 getLabel）
VITE_WEBHOOK_URL=your_webhook_url_here

# --- 生产部署 ---
# 在服务器/Secret Manager 注入同名变量：
#   VITE_API_KEY=<prod key>
#   VITE_API_BASE_URL=<prod base url from Vite support>
# 代码无需改变量名。
