# ===== UPS Track API 凭证（勿提交真值；本文件仅为变量名模板）=====
# 在仓库根 .env 或运行环境设置同名变量（真值只放 gitignored 位置）。

# OAuth client_credentials（UPS Developer 后台 https://developer.ups.com 创建 App 获取）
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# 环境：cie（测试，默认，wwwcie.ups.com）或 prod（生产，onlinetools.ups.com）
# 也可直接用 UPS_BASE_URL 覆盖。
UPS_API_ENV=cie

# 显式 base URL（可选；优先于 UPS_API_ENV）
#UPS_BASE_URL=https://wwwcie.ups.com

# HTTP(S) 代理（国内直连 onlinetools.ups.com 不通时使用）
#UPS_HTTP_PROXY=http://127.0.0.1:7890
