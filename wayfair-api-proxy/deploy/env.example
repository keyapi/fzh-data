# Copy to /etc/wayfair-api-proxy/env with mode 0640, owned by root:wayfair.
# Never commit real values. Rotate the Wayfair client secret before first start.
WAYFAIR_CENTRADE_CLIENT_ID=
WAYFAIR_CENTRADE_CLIENT_SECRET=
WAYFAIR_ACCOUNT_TWO_CLIENT_ID=
WAYFAIR_ACCOUNT_TWO_CLIENT_SECRET=
WAYFAIR_ACCOUNT_THREE_CLIENT_ID=
WAYFAIR_ACCOUNT_THREE_CLIENT_SECRET=

# DingTalk OIDC bridge (only needed for the /admin entry)
WAYFAIR_OIDC_CLIENT_ID=
WAYFAIR_OIDC_CLIENT_SECRET=
# openssl rand -hex 32
WAYFAIR_ADMIN_SESSION_SECRET=
# 自助门户会话签名密钥（独立于 admin；openssl rand -hex 32）
WAYFAIR_PORTAL_SESSION_SECRET=
