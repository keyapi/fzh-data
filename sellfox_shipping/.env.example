# sellfox_shipping — 根目录 .env 键清单（无真实值）
#
# 复制到仓库根 `.env`（gitignore）。env_loader 从根目录加载。
# 变量名跨环境一致，只换值（12-Factor）。不要用 *_TEST / *_PROD 作主命名。
# 冒烟脚本只读 env，不再从 Markdown 取密钥。

# --- 赛狐代理 ---
# SELLFOX_PROXY_API_KEY=your-sellfox-proxy-key

# --- VITE（默认开发 = 测试环境）---
VITE_API_KEY=your-vite-test-api-key
VITE_API_BASE_URL=https://test-api.vitedirect.com
# 同机偶尔需要生产 Key：用 gitignore 的 .env.vite.prod.local，或专用脚本 VITE_PROD_API_KEY

# --- 蜴国际 / yiglobal-api（仅生产）---
YIGLOBAL_APP_TOKEN=your-yiglobal-app-token
YIGLOBAL_APP_KEY=your-yiglobal-app-key
YIGLOBAL_API_BASE_URL=http://47.106.72.196
# 旧名已弃用：LIZARD_APP_TOKEN / LIZARD_APP_KEY（脚本暂兼容一版）

# --- 钉钉 OIDC（公网部署前打开；本地默认 auth.enabled=false 可不填）---
# SELLFOX_SHIPPING_AUTH_ENABLED=true
# SELLFOX_SHIPPING_SESSION_SECRET=generate-a-long-random-string
# OIDC_CLIENT_SECRET=from-oidc-bridge-admin
# OIDC_REDIRECT_URI=https://your-host/oidc-callback
# OIDC_CLIENT_ID=sellfox-shipping
# OIDC_ISSUER=https://api.vilavi.cn/oidc
