# US OpenAI API Proxy — 环境变量模板
# 复制为 .env 填入真实值（.env 已在 .gitignore 中排除）

# Vultr Windows VM
VULTR_PUBLIC_IP=
VULTR_TAILSCALE_IP=
VULTR_RDP_USER=

# Tailscale
TAILSCALE_BEIJING_IP=
TAILSCALE_BEIJING_HOST=
TAILSCALE_ACCOUNT=

# CLIProxyAPI
CLIPROXYAPI_PORT=8317
CLIPROXYAPI_SECRET_KEY=
CLIPROXYAPI_API_KEY=

# ChatGPT OAuth
CHATGPT_OAUTH_EMAIL=
CHATGPT_SUBSCRIPTION_TYPE=
