# US OpenAI API Proxy — 环境变量模板
# 复制为 .env 填入真实值（.env 已在 .gitignore 中排除）
# 文档中所有 <VAR> 的真实值都存在这里

# === Ubuntu 24.04 服务器 ===
UBUNTU_PUBLIC_IP=
UBUNTU_TAILSCALE_IP=
UBUNTU_SSH_ALIAS=us-ubuntu-proxy

# === Tailscale 网络 ===
TAILSCALE_BEIJING_IP=
TAILSCALE_BEIJING_HOST=
TAILSCALE_LAN_GATEWAY_IP=
TAILSCALE_LAN_GATEWAY_PORT=3000

# === CLIProxyAPI ===
CLIPROXYAPI_VERSION=7.2.16
CLIPROXYAPI_PORT=8317
CLIPROXYAPI_SECRET_KEY=
CLIPROXYAPI_API_KEY=
CLIPROXYAPI_INSTALL_DIR=/opt/cliproxyapi

# === ChatGPT OAuth ===
CHATGPT_OAUTH_EMAIL=
CHATGPT_SUBSCRIPTION_TYPE=

# === SSH ===
SSH_KEY_PATH=~/.ssh/id_ed25519_us_proxy
SSH_USER=root
